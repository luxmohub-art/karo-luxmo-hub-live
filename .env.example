# =========================================================
# LUXMO HUB - ENVIRONMENT VARIABLES EXAMPLE
# =========================================================

# ---------------------------------------------------------
# FIREBASE CLIENT CONFIGURATION
# Replace all placeholder values with your Firebase values
# ---------------------------------------------------------

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID


# ---------------------------------------------------------
# COMPANY DETAILS
# ---------------------------------------------------------

VITE_COMPANY_NAME=LUXMO HUB
VITE_COMPANY_EMAIL=luxmohub@gmail.com

VITE_COMPANY_PHONE=YOUR_PRIMARY_PHONE
VITE_COMPANY_PHONE_ALT=YOUR_ALTERNATE_PHONE


# ---------------------------------------------------------
# BANK DETAILS
# Keep these values only if your website actually displays
# bank-transfer/payment information.
# ---------------------------------------------------------

VITE_COMPANY_BANK=YOUR_BANK_NAME
VITE_COMPANY_ACCOUNT=YOUR_ACCOUNT_NUMBER
VITE_COMPANY_IFSC=YOUR_IFSC_CODE


# ---------------------------------------------------------
# RAZORPAY - CLIENT
# ---------------------------------------------------------

VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID


# ---------------------------------------------------------
# RAZORPAY - SERVER
# DO NOT put secret keys in VITE_ variables.
# Add the actual values in Vercel Environment Variables.
# ---------------------------------------------------------

RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET


# ---------------------------------------------------------
# ADMIN SESSION
# Add the real secret only in Vercel Environment Variables.
# ---------------------------------------------------------

ADMIN_SESSION_SECRET=YOUR_LONG_RANDOM_ADMIN_SESSION_SECRET


# ---------------------------------------------------------
# WEBSITE URL
# ---------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://www.luxmohub.in


# ---------------------------------------------------------
# LOGISTICS - SHIPROCKET
# Add actual values in Vercel Environment Variables.
# ---------------------------------------------------------

SHIPROCKET_EMAIL=YOUR_SHIPROCKET_EMAIL
SHIPROCKET_PASSWORD=YOUR_SHIPROCKET_PASSWORD
SHIPROCKET_PICKUP_LOCATION=YOUR_SHIPROCKET_PICKUP_LOCATION


# ---------------------------------------------------------
# DEFAULT LOGISTICS PROVIDER
# ---------------------------------------------------------

DEFAULT_LOGISTICS_PROVIDER=shiprocket


# ---------------------------------------------------------
# DEFAULT PACKAGE DIMENSIONS
# ---------------------------------------------------------

DEFAULT_PACKAGE_LENGTH=20
DEFAULT_PACKAGE_BREADTH=15
DEFAULT_PACKAGE_HEIGHT=10
DEFAULT_PACKAGE_WEIGHT=1


# ---------------------------------------------------------
# ITHINK LOGISTICS
# Only required if you are using iThink Logistics.
# ---------------------------------------------------------

ITHINK_EMAIL=YOUR_ITHINK_EMAIL
ITHINK_PASSWORD=YOUR_ITHINK_PASSWORD
ITHINK_SECRET=YOUR_ITHINK_SECRET
