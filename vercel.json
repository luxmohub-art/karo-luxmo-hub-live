{
  "rewrites": [
    {
      "source": "/api/admin-logout",
      "destination": "/api/admin-session?logout=1"
    },
    {
      "source": "/api/admin/master-settings",
      "destination": "/api/publish?master=1"
    },
    {
      "source": "/api/products",
      "destination": "/api/publish?products=1"
    },
    {
      "source": "/api/check-serviceability",
      "destination": "/api/create-order?serviceability=1"
    },
    {
      "source": "/api/customer-session",
      "destination": "/api/orders?action=customer-session"
    },
    {
      "source": "/api/whatsapp/webhook",
      "destination": "/api/orders?whatsapp_webhook=1"
    },
    {
      "source": "/api/whatsapp-abandoned",
      "destination": "/api/orders?action=whatsapp-abandoned"
    }
  ],
  "crons": [
    {
      "path": "/api/whatsapp-abandoned",
      "schedule": "0 * * * *"
    }
  ]
}
